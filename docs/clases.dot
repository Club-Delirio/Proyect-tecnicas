digraph UML {
  graph [rankdir=TB, splines=polyline, bgcolor="white", fontname="Helvetica",
         nodesep=0.5, ranksep=0.7, compound=true, pad=0.3];
  node  [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9];

  subgraph cluster_semana5 {
    label = <<B>Diagrama de clases — paquete semana5</B><BR/><FONT POINT-SIZE="9">Sistema de gestión de matrícula y control de asistencia</FONT>>;
    labelloc = "t";
    fontname = "Helvetica";
    fontsize = 13;
    style = "rounded";
    color = "#7f8c8d";
    penwidth = 1.2;
    margin = 18;

    Semana5 [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
     <TR><TD BGCOLOR="#8e44ad"><FONT COLOR="white"><B>Semana5</B></FONT></TD></TR>
     <TR><TD ALIGN="LEFT" BALIGN="LEFT">(sin atributos de instancia)</TD></TR>
     <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ecf0f1">
     + main(args : String[]) : void<BR/>
     + registrarPersona(sc : Scanner, controla : PersonaController) : void
     </TD></TR>
    </TABLE>>];

    PersonaController [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
     <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>PersonaController</B></FONT></TD></TR>
     <TR><TD ALIGN="LEFT" BALIGN="LEFT">
     ~ lista : ArrayList&lt;Persona&gt;
     </TD></TR>
     <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ecf0f1">
     + AgregarPersona(nuevapersona : Persona) : boolean<BR/>
     + listarPersonas() : void<BR/>
     + listarPersonas(tipo_doc : String) : void<BR/>
     + listarPersonas(edad_minima : int, edad_maxima : int) : void<BR/>
     + buscarPersona(nro_documento : String) : Persona<BR/>
     + obtenerPersona(posicion : int) : Persona<BR/>
     + eliminarPersona(nro_documento : String) : void<BR/>
     + ordenarPorApellido() : void<BR/>
     + contarPorTipo(tipo_doc : String) : int<BR/>
     + getCantidad() : int
     </TD></TR>
    </TABLE>>];

    Persona [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
     <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>Persona</B></FONT></TD></TR>
     <TR><TD ALIGN="LEFT" BALIGN="LEFT">
     - tipo_doc : String<BR/>
     - nro_documento : String<BR/>
     - nombre : String<BR/>
     - ape_paterno : String<BR/>
     - ape_materno : String<BR/>
     - fecha_nacimiento : LocalDate
     </TD></TR>
     <TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ecf0f1">
     + Persona()<BR/>
     + Persona(tipo_doc : String)<BR/>
     + Persona(tipo_doc : String, nro_documento : String)<BR/>
     + Persona(tipo_doc, nro_documento, nombre, ape_paterno, ape_materno, fecha_nacimiento)<BR/>
     + getTipo_doc() : String<BR/>
     + setTipo_doc(tipo_doc : String) : void<BR/>
     + getNro_documento() : String<BR/>
     + setNro_documento(nro_documento : String) : void<BR/>
     + getNombre() : String<BR/>
     + setNombre(nombre : String) : void<BR/>
     + getApe_paterno() : String<BR/>
     + setApe_paterno(ape_paterno : String) : void<BR/>
     + getApe_materno() : String<BR/>
     + setApe_materno(ape_materno : String) : void<BR/>
     + getFecha_nacimiento() : LocalDate<BR/>
     + setFecha_nacimiento(fecha_nacimiento : LocalDate) : void<BR/>
     + VerDatos() : void<BR/>
     + VerDatos(titulo : String) : void<BR/>
     + NombreCompleto() : String<BR/>
     + NombreCompleto(apellidos_primero : boolean) : String<BR/>
     + CalcularEdad() : int<BR/>
     + CalcularEdad(fecha_referencia : LocalDate) : int
     </TD></TR>
    </TABLE>>];

    Semana5 -> PersonaController [arrowhead=vee, style=dashed, label=" usa"];
    Semana5 -> Persona [arrowhead=vee, style=dashed, label=" crea"];
    PersonaController -> Persona [arrowhead=odiamond, dir=back, taillabel="1 ", headlabel=" 0..*", label=" almacena"];
  }
}
