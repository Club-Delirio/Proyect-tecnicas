        <mxCell id="leyenda" value="&lt;b&gt;Leyenda de notación UML&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Relaciones&lt;/b&gt;&lt;br&gt;——▷&amp;nbsp;&amp;nbsp;Generalización: línea continua y triángulo hueco hacia la superclase&lt;br&gt;———&amp;nbsp;&amp;nbsp;Asociación: línea continua sin punta, con multiplicidad en cada extremo&lt;br&gt;——›&amp;nbsp;&amp;nbsp;Asociación dirigida: la clase de origen conoce a la de destino&lt;br&gt;◇——&amp;nbsp;&amp;nbsp;Agregación: el rombo hueco va en el TODO. La parte vive sin el todo&lt;br&gt;- - - -&amp;nbsp;&amp;nbsp;Clase asociación: raya discontinua &lt;i&gt;sin punta&lt;/i&gt; desde la clase hasta la línea de la asociación&lt;br&gt;- - ›&amp;nbsp;&amp;nbsp;Dependencia «use»: la usa, pero no la guarda como atributo&lt;br&gt;●&amp;nbsp;&amp;nbsp;Punto de unión: no es una clase, es el punto de la línea de asociación&lt;br&gt;&lt;br&gt;&lt;b&gt;Compartimentos&lt;/b&gt;&lt;br&gt;+ · # · −&amp;nbsp;&amp;nbsp;Visibilidad pública · protegida · privada&lt;br&gt;&lt;i&gt;cursiva&lt;/i&gt;&amp;nbsp;&amp;nbsp;Clase u operación abstracta, marcada además con {abstract}&lt;br&gt;&lt;b&gt;negrita&lt;/b&gt;&amp;nbsp;&amp;nbsp;Operación sobrescrita en la subclase (polimorfismo)&lt;br&gt;&lt;u&gt;subrayado&lt;/u&gt;&amp;nbsp;&amp;nbsp;Miembro estático (de clase, no de instancia)&lt;br&gt;[0..*]&amp;nbsp;&amp;nbsp;Multiplicidad. Sustituye a ArrayList&amp;lt;T&amp;gt;, que es de Java y no de UML&lt;br&gt;&lt;br&gt;&lt;b&gt;Tipos&lt;/b&gt;&lt;br&gt;Tipos primitivos de UML 2.5: &lt;b&gt;String&lt;/b&gt;, &lt;b&gt;Integer&lt;/b&gt;, &lt;b&gt;Real&lt;/b&gt; y &lt;b&gt;Boolean&lt;/b&gt;.&lt;br&gt;No se escriben int, double ni boolean: son de Java.&lt;br&gt;Las operaciones void se escriben sin tipo de retorno.&lt;br&gt;Los tipos que no son primitivos (LocalDate, Scanner) se escriben con su nombre.&lt;br&gt;&lt;br&gt;14 clases · paquete academia" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFDE7;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2561" y="40" width="560" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="titulo" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Diagrama de clases — Sistema de gestión de matrícula y control de asistencia&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Academia Preuniversitaria San Fernando · Paquete academia · 10 clases · UPN Cajamarca 2026-2&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="-90" width="2481" height="60" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
